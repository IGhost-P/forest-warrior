{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "forest-warrior",
	"main": "worker/index.ts",
	"compatibility_date": "2025-06-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
